From 69cf73edc9ae387cc6973d15bc8df4203c93db71 Mon Sep 17 00:00:00 2001
From: Cedric DOURLENT <cedric.dourlent@softathome.com>
Date: Tue, 5 Dec 2023 13:06:44 +0100
Subject: [PATCH] JIRA HGWPR-25817: filter out -fpic and -DPIC coming from
 openwrt when CONFIG_PKG_ASLR_PIE_ALL=y

---
 scripts/Makefile.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/Makefile.build b/scripts/Makefile.build
index a66de262..cdb35285 100644
--- a/scripts/Makefile.build
+++ b/scripts/Makefile.build
@@ -217,7 +217,7 @@ ifdef builtin-target
 quiet_cmd_link_o_target = LD      $@
 # If the list of objects to link is empty, just create an empty built-in.o
 cmd_link_o_target = $(if $(strip $(obj-y)),\
-		      $(LD) $(ld_flags) -r -o $@ $(filter $(obj-y), $^), \
+		      $(LD) $(filter-out -fpic -DPIC,$(ld_flags)) -r -o $@ $(filter $(obj-y), $^), \
 		      rm -f $@; $(AR) rcs$(KBUILD_ARFLAGS) $@)
 
 $(builtin-target): $(obj-y) FORCE
